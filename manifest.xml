<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>a7e6c9d2-4f1b-4c3a-9e8d-1b2c3d4e5f6a</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>FTBC Procurement</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Track Request" />
  <Description DefaultValue="Tag the open email for the Engineer Request Tracker." />
  <IconUrl DefaultValue="https://REPLACE_WITH_PAGES_URL/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://REPLACE_WITH_PAGES_URL/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://REPLACE_WITH_PAGES_URL/" />
  <AppDomains></AppDomains>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://REPLACE_WITH_PAGES_URL/commands.html" />
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="TrackerGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="TrackRequestButton">
                  <Label resid="TrackButton.Label" />
                  <Supertip>
                    <Title resid="TrackButton.Label" />
                    <Description resid="TrackButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>trackRequest</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://REPLACE_WITH_PAGES_URL/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://REPLACE_WITH_PAGES_URL/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://REPLACE_WITH_PAGES_URL/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://REPLACE_WITH_PAGES_URL/commands.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Tracker" />
        <bt:String id="TrackButton.Label" DefaultValue="Track Request" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TrackButton.Tooltip" DefaultValue="Tags this email '→ Track' for the Engineer Request Tracker. Processed on your next Sync Now or the 8AM refresh." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
